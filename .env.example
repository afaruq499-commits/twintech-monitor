# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT VARIABLES (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya dengan kredensial Anda.
# JANGAN PERNAH MENGUNGGAH FILE .env ASLI KE GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI DATABASE (PILIH SALAH SATU FORMAT DI BAWAH)
# ------------------------------------------------------------------------------

# OPSI A: Menggunakan DATABASE_URL Tunggal (Direkomendasikan untuk Vercel / Render / Supabase)
#
# A.1. PostgreSQL di Cloud Gratis (Supabase / Neon / Railway)
#      Jalankan: npm run db:switch:postgres
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public&sslmode=prefer"
#
# A.2. Microsoft SQL Server Cloud (Azure SQL Free Tier / Docker / On-Premise)
#      Jalankan: npm run db:switch:sqlserver
# DATABASE_URL="sqlserver://[SERVER_NAME].database.windows.net:1433;database=[DB_NAME];user=[USERNAME];password=[PASSWORD];encrypt=true;trustServerCertificate=true"

# OPSI B: Menggunakan Variabel Individual (Jika platform cloud Anda menginjeksi variabel terpisah)
DB_TYPE="sqlserver"                  # Pilihan: "sqlserver" atau "postgres"
DB_HOST="localhost"                 # Contoh Azure: your-server.database.windows.net | Supabase: db.xxxx.supabase.co
DB_PORT="1433"                      # 1433 untuk SQL Server, 5432 untuk PostgreSQL
DB_NAME="project_monitor"           # Nama database
DB_USER="sa"                        # Username database
DB_PASSWORD="YourSecurePassword123" # Password database
DB_ENCRYPT="true"                   # Enkripsi TLS (true untuk Azure SQL / Cloud)
DB_TRUST_SERVER_CERTIFICATE="true"  # true jika sertifikat self-signed

# ------------------------------------------------------------------------------
# 2. KONFIGURASI APLIKASI
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# Kunci rahasia untuk otentikasi / session JWT (ganti dengan string acak aman)
JWT_SECRET="ganti-dengan-string-rahasia-minimal-32-karakter-acak"
