<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS web.config untuk Project Monitor PT Twintech
  File ini ditempatkan di folder root website IIS
  Fungsi: meneruskan semua request dari port 80 ke Next.js di port 3000

  SYARAT: IIS harus sudah terinstall modul:
    - URL Rewrite Module
    - Application Request Routing (ARR)
    - ARR Proxy harus diaktifkan di Server level
-->
<configuration>
  <system.webServer>

    <!-- Nonaktifkan halaman error IIS default agar error Next.js terlihat -->
    <httpErrors existingResponse="PassThrough" />

    <!-- URL Rewrite: teruskan semua traffic ke Next.js port 3000 -->
    <rewrite>
      <rules>
        <rule name="NextJS Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="." />
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Header keamanan dasar -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
